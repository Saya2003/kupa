# Convex (filled in automatically when you run `npx convex dev`)
VITE_CONVEX_URL=

# Backend AI Configuration (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
EXTRACTION_MODEL="deepseek/deepseek-v4-flash"
RESPONSE_MODEL="deepseek/deepseek-v4-flash"

# Convex Auth (generate with `node generateKeys.mjs`, then `npm run convex:env`)
JWT_PRIVATE_KEY=
JWKS=
CONVEX_SITE_URL=
